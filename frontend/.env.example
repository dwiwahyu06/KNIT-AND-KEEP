# Salin berkas ini menjadi .env (untuk pengembangan) atau .env.production
# (untuk build yang diunggah ke server), lalu sesuaikan isinya.

# Alamat backend, harus lengkap sampai /api dan tanpa garis miring di akhir.
# Contoh saat dijalankan di komputer sendiri:
VITE_API_BASE=http://localhost:8080/api

# Contoh saat sudah dipublikasi:
# VITE_API_BASE=https://api.knitandkeep.com/api
