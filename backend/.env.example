# =============================================================================
#  Contoh pengaturan server. Salin menjadi .env (atau isikan satu per satu di
#  panel hosting), lalu ganti setiap nilai di bawah.
#
#  Berkas .env yang asli TIDAK BOLEH masuk Git — isinya kunci yang bisa dipakai
#  orang lain menarik dana toko.
#
#  Begitu MIDTRANS_PRODUCTION=true, aplikasi menolak menyala kalau masih ada
#  nilai bawaan yang belum diganti (lihat PemeriksaKesiapanRilis).
# =============================================================================

# ---------- Database ----------
DB_URL=jdbc:postgresql://alamat-database:5432/knit-and-keep
DB_USERNAME=knitkeep
DB_PASSWORD=ganti-dengan-kata-sandi-panjang-dan-acak

# Di server skema database tidak boleh diubah sendiri oleh aplikasi.
DDL_AUTO=validate

# ---------- Alamat ----------
PORT=8080
CORS_ORIGINS=https://tokoanda.com
UNGGAHAN_FOLDER=/data/unggahan
UNGGAHAN_URL=/unggahan

# ---------- Token masuk ----------
# Minimal 32 karakter acak. Menggantinya mengeluarkan semua sesi yang berjalan.
# Membuatnya: openssl rand -base64 48
JWT_SECRET=ganti-dengan-teks-acak-minimal-32-karakter
JWT_JAM=12

# ---------- Midtrans ----------
MIDTRANS_PRODUCTION=true
MIDTRANS_SERVER_KEY=Mid-server-ISI-KUNCI-PRODUKSI-ANDA
MIDTRANS_CLIENT_KEY=Mid-client-ISI-KUNCI-PRODUKSI-ANDA
MIDTRANS_EXPIRY_MINUTES=1440
MIDTRANS_POLLING=true
MIDTRANS_POLLING_MS=60000

# ---------- RajaOngkir (Komerce) ----------
RAJAONGKIR_KEY=ISI-KUNCI-ANDA-SENDIRI
RAJAONGKIR_URL=https://rajaongkir.komerce.id/api/v1

# ---------- Toko ----------
TOKO_NAMA=Knit & Keep
TOKO_ORIGIN_ID=4816
TOKO_ORIGIN_LABEL=Bandung, Jawa Barat
TOKO_KURIR=jne:sicepat:jnt:pos:tiki
TOKO_BERAT_MINIMUM=1000

# Dipakai hanya saat layanan ongkir mati atau kuotanya habis, supaya toko
# tetap bisa menerima pesanan. Bentuknya kode:nama:tarif:estimasi.
TOKO_ONGKIR_CADANGAN=HEMAT:Pengiriman Hemat:9000:4-7 hari,REGULER:Pengiriman Reguler:15000:2-4 hari,EKSPRES:Pengiriman Ekspres:28000:1-2 hari

# ---------- Zona waktu ----------
TZ=Asia/Jakarta

# ---------- Akun pengelola pertama ----------
# Hanya dipakai sekali, saat database masih benar-benar kosong.
# Kalau sandinya dikosongkan, aplikasi membuatkan sandi acak dan mencetaknya
# satu kali di log — segera masuk dan gantilah.
ADMIN_AWAL_USERNAME=pemilik
ADMIN_AWAL_EMAIL=pemilik@tokoanda.com
ADMIN_AWAL_PASSWORD=

# ---------- Data contoh ----------
# Biarkan false di server. Produk dan akun pelanggan contoh hanya berguna saat
# aplikasi baru dicoba, dan akan terisi ulang sendiri setiap kali tabelnya
# dikosongkan.
DATA_CONTOH=false

# ---------- Pemeliharaan ----------
SIMPAN_NOTIFIKASI_HARI=90
